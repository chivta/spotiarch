# Path the browser calls. Keep it relative so the SPA stays same-origin and no
# CORS is needed; the dev server proxies it and traefik routes it in production.
VITE_API_BASE_URL=/api
# Where the Vite dev server forwards /api. Server-side only, never seen by the
# browser. Compose sets this to http://api:8080.
VITE_API_URL=http://localhost:8080
